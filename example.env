# wtffmpeg Environment Variables

# Model to use (e.g., llama3, gpt-5.4-mini)
WTFFMPEG_MODEL=

# OpenAI API Key (if using OpenAI)
WTFFMPEG_OPENAI_API_KEY=

# Bearer Token for authentication with other services
WTFFMPEG_BEARER_TOKEN=

# URL for a local LLM API like Ollama
WTFFMPEG_LLM_API_URL=

# Force provider selection: "openai" or "compat" (cli: --provider)
# If unset, inferred: openai when an API key is set and no URL is given; compat otherwise.
WTFFMPEG_PROVIDER=

# System prompt profile name (cli: --profile; default: minimal)
WTFFMPEG_PROFILE=

# Alternate directory for default --profile-dir
WTFFMPEG_PROFILE_DIR=